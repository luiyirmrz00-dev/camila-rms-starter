{
  "name": "camila-gastrobar-rms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var APP_ENV:development",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create camila-rms-db",
    "db:migrate:local": "wrangler d1 migrations apply camila-rms-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply camila-rms-db --remote",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.160.0"
  }
}
